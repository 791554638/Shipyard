# ============================================================
# 环境变量模板（v0.3.0 参数管理 · 见 docs/secrets-management.md）
#
# 用法：复制为 .env 并按需修改
#   cp .env.example .env
#
# 规则：
#   - .env 已被 .gitignore 排除，绝不提交到 git
#   - 本文件是学习默认值的【唯一存放处】：
#     docker compose 与 scripts/deploy.sh 均从 .env 注入密码，
#     缺失即报错退出（仓库代码零明文密码）
#   - 生产环境务必修改全部密码
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=cfapass

# Elasticsearch（elastic 用户，首次启动时自动设置）
ELASTIC_PASSWORD=Cfa@Elastic2026

# 运行环境标识：dev（研发）/ prod（生产）
# 透传给 php 容器的 APP_ENV，控制应用运行时行为（调试开关/日志级别等）。
# 注意：是否挂载本地代码目录由 docker-compose.override.yml 决定，与此参数无关——
#   docker compose up -d            研发模式（自动合并 override：代码挂载+热更新）
#   docker compose -f docker-compose.yml up -d   生产模式（仅镜像内代码）
APP_ENV=dev
