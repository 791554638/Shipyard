# ============================================================
# 环境变量模板（v0.3.0 参数管理 · 见 docs/secrets-management.md）
#
# 用法：复制为 .env 并按需修改
#   cp .env.example .env
#
# 规则：
#   - .env 已被 .gitignore 排除，绝不提交到 git
#   - 本文件是学习默认值的【唯一存放处】：
#     docker compose 与 scripts/deploy.sh 均从 .env 注入密码，
#     缺失即报错退出（仓库代码零明文密码）
#   - 生产环境务必修改全部密码
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=cfapass

# Elasticsearch（elastic 用户，首次启动时自动设置）
ELASTIC_PASSWORD=Cfa@Elastic2026
